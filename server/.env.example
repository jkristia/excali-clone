# Server bind address / port
HOST=0.0.0.0
PORT=1234

# Comma-separated list of allowed browser origins. Leave empty to allow all
# (fine for local dev). In production set this, e.g.:
# ALLOWED_ORIGINS=https://board.example.com

# Enable durable persistence by pointing at a writable directory (LevelDB).
# Leave unset for in-memory-only (state lost on restart).
# PERSISTENCE_DIR=./.data
